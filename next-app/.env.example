# Configure ONE provider on the SERVER only. Never prefix keys with NEXT_PUBLIC_.
# Gemini may offer a limited free tier depending on region/usage.
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Alternative: AI_PROVIDER=anthropic, set its key, and optionally model.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
